# Used only by scripts/fetch-dashboard-data.mjs (a Node build script), never
# by client code - do NOT prefix these with VITE_ or Vite will inline them
# into the browser bundle.

# Public GitHub username whose public contribution calendar to display.
# In GitHub Actions this is set from a repo variable named
# DASHBOARD_GITHUB_USERNAME (not GITHUB_USERNAME - Actions reserves the
# GITHUB_ prefix for its own built-in vars/secrets).
GITHUB_USERNAME=lvkey

# Shared Supabase project (same one Ledgr/Immersio use). Must be the
# service-role key, not the anon key - it needs to bypass RLS since rows are
# scoped to anonymous auth.uid()s the build script has no session for.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
